---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * ツール一覧。ツールを追加したらここに1行足す。
 * status: 'ready' は公開済み、'planned' は予定（リンクしない）。
 * audience: 'engineer' はエンジニア向け、'general' は誰でも使える想定。
 */
const tools = [
  {
    href: '/tools/cron/',
    name: 'cron式チェッカー',
    summary: 'cron式を日本語に翻訳し、次の実行時刻を一覧表示する。日付と曜日のOR条件にも対応。',
    status: 'ready' as const,
    audience: 'engineer' as const,
  },
  {
    href: '/tools/timestamp/',
    name: 'Unixタイムスタンプ変換',
    summary: 'タイムスタンプ⇄日時を相互変換。秒・ミリ秒の自動判定つき。',
    status: 'ready' as const,
    audience: 'engineer' as const,
  },
  {
    href: '/tools/json/',
    name: 'JSON整形・検証ツール',
    summary: 'JSONを整形・ミニファイし、構文エラーを行番号つきで表示。重複キーも検出する。',
    status: 'ready' as const,
    audience: 'engineer' as const,
  },
  {
    href: '/tools/password/',
    name: 'パスワード生成器',
    summary: '安全な乱数で作るランダムパスワード。強度の目安も表示。',
    status: 'ready' as const,
    audience: 'general' as const,
  },
  {
    href: '/tools/charcount/',
    name: '文字数・バイト数カウンター',
    summary: 'X（旧Twitter）やThreadsなどの文字数上限に対する残り文字数をリアルタイム表示。',
    status: 'ready' as const,
    audience: 'general' as const,
  },
  {
    href: '/tools/units/',
    name: '単位変換ツール',
    summary: '長さ・重さ・温度を変換。海外のレシピや資料でインチや華氏が出てきたときに。',
    status: 'ready' as const,
    audience: 'general' as const,
  },
  {
    href: '/tools/qr/',
    name: 'QRコード作成',
    summary: 'URLや文章からQRコードを作り、PNG画像かSVGで保存できる。誤り訂正レベルと大きさも選べる。',
    status: 'ready' as const,
    audience: 'general' as const,
  },
  {
    href: '/tools/calc/',
    name: '関数電卓',
    summary: '三角関数・対数・平方根・階乗まで扱える電卓。式をまとめて書けて、度とラジアンを切り替えられる。',
    status: 'ready' as const,
    audience: 'general' as const,
  },
  {
    name: 'cron → GitHub Actions 変換',
    summary: 'ローカル時刻で書いたcron式をUTCに直して、Actions用のYAMLを出力する。',
    status: 'planned' as const,
    audience: 'engineer' as const,
  },
];

const ready = tools.filter((t) => t.status === 'ready');
const engineerTools = ready.filter((t) => t.audience === 'engineer');
const generalTools = ready.filter((t) => t.audience === 'general');
const planned = tools.filter((t) => t.status === 'planned');
---

<BaseLayout>
  <h1>ちょっと便利な小さな道具箱</h1>
  <p class="lead">
    エンジニアの手元の作業から、日常のちょっとした計算まで。
    すべてブラウザ内で完結するので、入力した内容がどこかへ送られることはありません。
  </p>

  <h2>エンジニア向け</h2>
  <ul class="tools">
    {engineerTools.map((tool) => (
      <li>
        <a href={tool.href}>
          <span class="name">{tool.name}</span>
          <span class="summary">{tool.summary}</span>
        </a>
      </li>
    ))}
  </ul>

  <h2>誰でも使えるツール</h2>
  <ul class="tools">
    {generalTools.map((tool) => (
      <li>
        <a href={tool.href}>
          <span class="name">{tool.name}</span>
          <span class="summary">{tool.summary}</span>
        </a>
      </li>
    ))}
  </ul>

  {planned.length > 0 && (
    <>
      <h2>作る予定</h2>
      <ul class="tools planned">
        {planned.map((tool) => (
          <li>
            <span class="name">{tool.name}</span>
            <span class="summary">{tool.summary}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <style>
    .lead {
      color: var(--muted);
      margin-top: 0;
    }

    .tools {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .tools li {
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 0.6rem;
      background: var(--surface);
    }

    .tools a,
    .tools li > .name {
      display: block;
      padding: 0.9rem 1rem;
      text-decoration: none;
      color: inherit;
    }

    .tools a:hover {
      border-color: var(--accent);
    }

    .name {
      display: block;
      font-weight: 600;
      color: var(--accent);
    }

    .tools a:hover .name {
      text-decoration: underline;
    }

    .summary {
      display: block;
      font-size: 0.875rem;
      color: var(--muted);
      line-height: 1.6;
    }

    .planned li {
      background: transparent;
      border-style: dashed;
      padding: 0.9rem 1rem;
    }
    .planned .name {
      color: var(--muted);
      font-weight: 600;
    }
  </style>
</BaseLayout>
