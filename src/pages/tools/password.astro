---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'パスワード生成器';
const description =
  '安全なランダムパスワードをブラウザ内で生成します。強度の目安も表示します。入力・生成結果は一切サーバーに送信されません。';
---

<BaseLayout title={title} description={description} breadcrumb={[]}>
  <h1>パスワード生成器</h1>
  <p class="lead">
    ランダムなパスワードをその場で作ります。生成はすべてこのページの中（お使いのブラウザ）で
    完結していて、どこにも送信されません。ページを閉じたり再読み込みしたりすると、
    生成したパスワードはどこにも残らず消えます。
  </p>

  <div class="tool">
    <div class="row">
      <label class="field">
        <span class="field-label">長さ: <output id="length-value">16</output>文字</span>
        <input id="length" type="range" min="4" max="64" value="16" />
      </label>
    </div>

    <div class="checks">
      <label class="check"><input type="checkbox" id="uppercase" checked /> 大文字（A〜Z）</label>
      <label class="check"><input type="checkbox" id="lowercase" checked /> 小文字（a〜z）</label>
      <label class="check"><input type="checkbox" id="numbers" checked /> 数字（0〜9）</label>
      <label class="check"><input type="checkbox" id="symbols" checked /> 記号（!@#$ など）</label>
      <label class="check">
        <input type="checkbox" id="excludeAmbiguous" />
        紛らわしい文字を除く（<code>0</code>と<code>O</code>、<code>1</code>と<code>l</code>や<code>I</code>など）
      </label>
    </div>

    <button type="button" id="generate" class="generate-btn">生成する</button>

    <div id="output-area" class="output-area" hidden>
      <div class="password-row">
        <output id="password" class="password" aria-live="polite"></output>
        <button type="button" id="copy" class="copy-btn">コピー</button>
      </div>
      <p id="copy-status" class="copy-status" role="status"></p>

      <div class="strength">
        <div class="strength-bar-track">
          <div id="strength-bar" class="strength-bar-fill"></div>
        </div>
        <p id="strength-text" class="strength-text"></p>
      </div>
    </div>

    <p id="error" class="error" hidden></p>
  </div>

  <h2>なぜランダムなパスワードが必要か</h2>
  <p>
    「誕生日」「好きな単語＋数字」のような自分で考えたパスワードは、他人には分からなくても、
    実は機械的な推測（総当たりや辞書に基づく攻撃）に弱いことがよくあります。
    完全にランダムな文字の並びは、この種の推測が最も難しいパスワードです。
    人が覚えるのは大変なので、パスワード管理アプリと組み合わせて使うのがおすすめです。
  </p>

  <h2>このツールが安全な理由</h2>
  <p>
    2つの点を守っています。1つ目は、生成したパスワードを<strong>どこにも送信しない</strong>こと。
    このページを表示した時点で必要な処理はすべてブラウザの中だけで完結し、サーバーには何も送られません。
    2つ目は、乱数の作り方です。プログラムで「ランダム」を作る方法にはいくつか種類があり、
    このツールは<strong>パスワード生成用に安全だと認められている方法</strong>（ブラウザに標準で
    備わっている暗号用の乱数機能）を使っています。単純な乱数関数は将来の値が推測できてしまう
    ことがあるため、パスワードの生成には向いていません。
  </p>

  <h2>強度の目安について</h2>
  <p>
    表示される強度は、パスワードの長さと使っている文字の種類数から統計的に計算した目安です。
    実際の安全性は、同じパスワードを他のサービスで使い回していないか、
    漏洩したパスワードの一覧に含まれていないかなど、他の要因にも左右されます。
    「非常に強い」と出ても絶対に安全であることを保証するものではありません。
  </p>

  <style>
    .lead { color: var(--muted); margin-top: 0; }

    .tool {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.25rem;
      margin-block: 1.5rem;
    }

    .row { margin-bottom: 1rem; }
    .field { display: block; }
    .field-label {
      display: block;
      font-size: 0.875rem;
      color: var(--text);
      margin-bottom: 0.4rem;
    }
    .field-label output {
      font-family: var(--mono);
      font-weight: 600;
      color: var(--accent);
    }

    #length { width: 100%; accent-color: var(--accent); }

    .checks {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-bottom: 1.25rem;
    }
    .check {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9375rem;
    }
    .check input { accent-color: var(--accent); width: 1.05rem; height: 1.05rem; }

    .generate-btn {
      font: inherit;
      font-weight: 600;
      background: var(--accent);
      color: var(--surface);
      border: none;
      border-radius: 6px;
      padding: 0.6rem 1.1rem;
      cursor: pointer;
      width: 100%;
    }
    .generate-btn:hover { opacity: 0.9; }
    .generate-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .output-area { margin-top: 1.25rem; }

    .password-row {
      display: flex;
      gap: 0.5rem;
      align-items: stretch;
    }
    .password {
      flex: 1;
      font-family: var(--mono);
      font-size: 1.15rem;
      word-break: break-all;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.65rem 0.8rem;
      user-select: all;
    }
    .copy-btn {
      font: inherit;
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.5rem 0.9rem;
      cursor: pointer;
      white-space: nowrap;
    }
    .copy-btn:hover { border-color: var(--accent); color: var(--accent); }

    .copy-status {
      min-height: 1.2em;
      font-size: 0.8125rem;
      color: var(--accent);
      margin: 0.4rem 0 0;
    }

    .strength { margin-top: 1rem; }
    .strength-bar-track {
      height: 6px;
      border-radius: 999px;
      background: var(--border);
      overflow: hidden;
    }
    .strength-bar-fill {
      height: 100%;
      border-radius: 999px;
      background: var(--accent);
      transition: width 0.2s ease;
    }
    .strength-text {
      font-size: 0.8125rem;
      color: var(--muted);
      margin: 0.4rem 0 0;
    }

    .error {
      color: var(--danger);
      font-weight: 600;
      margin-top: 1rem;
    }
  </style>

  <script>
    import {
      generatePassword,
      calculateEntropy,
      strengthLabel,
      PasswordOptionsError,
      type PasswordOptions,
    } from '../../lib/password';

    const lengthInput = document.getElementById('length') as HTMLInputElement;
    const lengthValue = document.getElementById('length-value') as HTMLOutputElement;
    const uppercase = document.getElementById('uppercase') as HTMLInputElement;
    const lowercase = document.getElementById('lowercase') as HTMLInputElement;
    const numbers = document.getElementById('numbers') as HTMLInputElement;
    const symbols = document.getElementById('symbols') as HTMLInputElement;
    const excludeAmbiguous = document.getElementById('excludeAmbiguous') as HTMLInputElement;
    const generateBtn = document.getElementById('generate') as HTMLButtonElement;
    const outputArea = document.getElementById('output-area') as HTMLElement;
    const passwordOut = document.getElementById('password') as HTMLOutputElement;
    const copyBtn = document.getElementById('copy') as HTMLButtonElement;
    const copyStatus = document.getElementById('copy-status') as HTMLElement;
    const strengthBar = document.getElementById('strength-bar') as HTMLElement;
    const strengthText = document.getElementById('strength-text') as HTMLElement;
    const errorEl = document.getElementById('error') as HTMLElement;

    // 強度4段階を色相の違いでも区別できるようにする（色覚特性に配慮し、テキストラベルも必ず併記）
    const STRENGTH_COLORS: Record<string, string> = {
      弱い: 'var(--danger)',
      普通: '#c98a2c',
      強い: 'var(--accent)',
      非常に強い: 'var(--accent)',
    };

    function currentOptions(): PasswordOptions {
      return {
        length: Number(lengthInput.value),
        uppercase: uppercase.checked,
        lowercase: lowercase.checked,
        numbers: numbers.checked,
        symbols: symbols.checked,
        excludeAmbiguous: excludeAmbiguous.checked,
      };
    }

    lengthInput.addEventListener('input', () => {
      lengthValue.textContent = lengthInput.value;
    });

    function generate() {
      errorEl.hidden = true;
      copyStatus.textContent = '';
      const options = currentOptions();

      let password: string;
      try {
        password = generatePassword(options);
      } catch (err) {
        outputArea.hidden = true;
        errorEl.hidden = false;
        errorEl.textContent =
          err instanceof PasswordOptionsError ? err.message : 'パスワードを生成できませんでした';
        return;
      }

      passwordOut.textContent = password;

      const entropy = calculateEntropy(options);
      const label = strengthLabel(entropy);
      const pct = Math.min(100, (entropy / 100) * 100);
      strengthBar.style.width = `${pct}%`;
      strengthBar.style.background = STRENGTH_COLORS[label] ?? 'var(--accent)';
      strengthText.textContent = `強度: ${label}（推定 ${entropy.toFixed(1)} bit）`;

      outputArea.hidden = false;
    }

    generateBtn.addEventListener('click', generate);

    copyBtn.addEventListener('click', async () => {
      const text = passwordOut.textContent ?? '';
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        copyStatus.textContent = 'コピーしました';
      } catch {
        copyStatus.textContent = 'コピーできませんでした。手動で選択してコピーしてください。';
      }
    });

    // 初期表示時に1つ生成しておく
    generate();
  </script>
</BaseLayout>
